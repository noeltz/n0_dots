#!/usr/bin/env bash
# run_once_after_03-disable-plymouth.sh - Disable Plymouth splash screen
#
# Detects if Plymouth is active and disables it by removing the plymouth hook
# from mkinitcpio, updating kernel cmdline (across all bootloaders), disabling
# systemd services, and regenerating initramfs.
#
# Arch Linux only — skipped on Void Linux (Plymouth not typically used,
# and Void uses dracut instead of mkinitcpio).
#
# Globals:
#   LAST_ERROR - Error message from last failed operation
# Exit codes:
#   0 (success), 1 (failure)

{{- if eq .chezmoi.osRelease.id "void" }}
# Void Linux: Plymouth disable is not applicable (uses dracut, not mkinitcpio)
echo "[SKIP] Plymouth disable not applicable on Void Linux"
exit 0
{{- end }}

{{ template "run_onchange_hash" . }}

set -euo pipefail
shopt -s nullglob globstar

readonly LIB_DIR="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/.chezmoiscripts/lib"

# shellcheck source=/dev/null
source "$LIB_DIR/.lib-common.sh"

# shellcheck source=/dev/null
source "$LIB_DIR/.lib-snapboot.sh"

readonly PLYMOUTH_PACKAGE="plymouth"
readonly MKINITCPIO_CONF="/etc/mkinitcpio.conf"
readonly GRUB_FILE="/etc/default/grub"
readonly LIMINE_DROPIN_DIR="/etc/limine-entry-tool.d"
readonly LIMINE_DEFAULT_CONF="/etc/default/limine"
readonly SYSTEMD_CMDLINE_FILE="/etc/kernel/cmdline"
readonly SDMANAGE_CONF="/etc/sdboot-manage.conf"

# Known plymouth service names to try as fallback
readonly -a PLYMOUTH_SERVICES=(
  plymouth-start.service
  plymouth-quit.service
  plymouth-quit-wait.service
  plymouth-switch-root.service
  plymouth-read-write.service
)

# Checks if Plymouth package is installed.
#
# Returns:
#   0 if installed, 1 otherwise
_plymouth_installed() {
  pacman -Qi "$PLYMOUTH_PACKAGE" >/dev/null 2>&1
}

# Checks if Plymouth is considered active.
#
# Returns 0 if any of the following is true: package installed with
# plymouth in mkinitcpio HOOKS, or the splash kernel parameter present.
# Returns 1 if none indicate Plymouth is active.
_plymouth_is_active() {
  LAST_ERROR=""

  if ! _plymouth_installed; then
    return 1
  fi

  # Check mkinitcpio HOOKS for plymouth
  if [[ -f "$MKINITCPIO_CONF" ]]; then
    local hooks
    hooks=$(sed -nE 's/^[[:space:]]*HOOKS=\((.*)\)[[:space:]]*$/\1/p' "$MKINITCPIO_CONF" 2>/dev/null | head -n1)
    if [[ " ${hooks:-} " = *" plymouth "* ]]; then
      return 0
    fi
  fi

  # Check if any plymouth systemd units exist
  if systemctl list-unit-files 2>/dev/null | grep -q '^plymouth-'; then
    return 0
  fi

  if systemctl list-units --all 2>/dev/null | grep -q 'plymouth'; then
    return 0
  fi

  return 1
}

# Collects all plymouth systemd service names using multiple methods.
#
# Tries list-unit-files first, then list-units --all, then falls back
# to known service names.
#
# Outputs:
#   Service names to stdout, one per line
# Returns:
#   0 if any services found, 1 otherwise
_collect_plymouth_services() {
  (
    # Method 1: persistent unit files
    systemctl list-unit-files 2>/dev/null | awk '/^plymouth-/ {print $1}'
    # Method 2: loaded units
    systemctl list-units --all 2>/dev/null | awk '/plymouth/ {print $1}'
    # Method 3: known names
    printf '%s\n' "${PLYMOUTH_SERVICES[@]}"
  ) | sort -u
}

# Disables, stops, and masks all plymouth-* systemd services.
#
# Globals:
#   LAST_ERROR - Set on failure
# Returns:
#   0 always (non-fatal)
_disable_plymouth_services() {
  LAST_ERROR=""

  local services
  services=$(_collect_plymouth_services)

  if [[ -z "${services:-}" ]]; then
    log SKIP "No Plymouth systemd services found"
    return 0
  fi

  local found=0
  local svc
  while IFS= read -r svc; do
    [[ -z "$svc" ]] && continue

    if systemctl is-enabled "$svc" >/dev/null 2>&1; then
      sudo systemctl disable "$svc" >/dev/null 2>&1 || true
      log INFO "Disabled ${COLOR_CYAN}$svc${COLOR_RESET}"
      found=1
    fi

    if systemctl is-active "$svc" >/dev/null 2>&1; then
      sudo systemctl stop "$svc" >/dev/null 2>&1 || true
      log INFO "Stopped ${COLOR_CYAN}$svc${COLOR_RESET}"
      found=1
    fi

    if systemctl list-unit-files 2>/dev/null | grep -q "^${svc}[[:space:]]"; then
      sudo systemctl mask "$svc" >/dev/null 2>&1 || true
      log INFO "Masked ${COLOR_CYAN}$svc${COLOR_RESET}"
      found=1
    fi
  done <<<"$services"

  if [[ "$found" -eq 0 ]]; then
    log SKIP "No active Plymouth services to disable"
  fi

  return 0
}

# Removes plymouth hook from mkinitcpio.conf.
#
# Strips 'plymouth' from the HOOKS array while preserving order
# and spacing style of existing hooks.
#
# Globals:
#   LAST_ERROR - Set on failure
# Returns:
#   0 on success (removed or not present), 1 on failure
_remove_plymouth_from_mkinitcpio() {
  LAST_ERROR=""

  if [[ ! -f "$MKINITCPIO_CONF" ]]; then
    log SKIP "mkinitcpio.conf not found"
    return 0
  fi

  local current_hooks
  current_hooks=$(sed -nE 's/^[[:space:]]*HOOKS=\((.*)\)[[:space:]]*$/\1/p' "$MKINITCPIO_CONF" 2>/dev/null | head -n1)

  if [[ -z "$current_hooks" ]]; then
    log SKIP "Could not parse HOOKS from mkinitcpio"
    return 0
  fi

  if [[ " $current_hooks " != *" plymouth "* ]]; then
    log SKIP "Plymouth hook not present in mkinitcpio"
    return 0
  fi

  local new_hooks
  new_hooks=$(printf '%s' "$current_hooks" | sed 's/\bplymouth\b//g' | tr -s ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

  if ! sudo sed -i -E "s|^[[:space:]]*HOOKS=\(.*\)|HOOKS=($new_hooks)|" "$MKINITCPIO_CONF" 2>/dev/null; then
    LAST_ERROR="Failed to update $MKINITCPIO_CONF"
    return 1
  fi

  log INFO "Removed plymouth hook from mkinitcpio"
  return 0
}

# Removes 'splash' from a kernel cmdline string and adds plymouth.enable=0.
#
# Arguments:
#   $1 - Current cmdline string
# Outputs:
#   Modified cmdline to stdout
_clean_cmdline() {
  local current="${1:-}"
  local cleaned

  # Remove 'splash' and 'quiet' parameters
  cleaned=$(printf '%s' "$current" | sed 's/\bsplash\b//g; s/\bquiet\b//g' | tr -s ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

  # Add plymouth.enable=0 disablehooks=plymouth using build_cmdline (handles dedup)
  build_cmdline "$cleaned" "plymouth.enable=0 disablehooks=plymouth"
}

# Updates GRUB kernel cmdline to remove splash and add plymouth.enable=0.
#
# Globals:
#   LAST_ERROR - Set on failure
# Returns:
#   0 on success, 1 on failure
_update_grub_cmdline() {
  LAST_ERROR=""

  if [[ ! -f "$GRUB_FILE" ]]; then
    log SKIP "GRUB config not found"
    return 0
  fi

  local current
  current=$(sed -nE 's/^GRUB_CMDLINE_LINUX_DEFAULT="(.*)"/\1/p' "$GRUB_FILE" 2>/dev/null | head -n1)

  if [[ -z "$current" ]]; then
    log SKIP "GRUB_CMDLINE_LINUX_DEFAULT not found"
    return 0
  fi

  local new_cmdline
  if ! new_cmdline=$(_clean_cmdline "$current"); then
    LAST_ERROR="Failed to build new GRUB cmdline"
    return 1
  fi

  if [[ "$new_cmdline" == "$current" ]]; then
    log SKIP "GRUB cmdline already configured"
    return 0
  fi

  if ! update_config "$GRUB_FILE" "GRUB_CMDLINE_LINUX_DEFAULT" "\"$new_cmdline\""; then
    LAST_ERROR="Failed to update GRUB config: $LAST_ERROR"
    return 1
  fi

  local mkconfig
  if command_exists grub-mkconfig; then
    mkconfig="grub-mkconfig"
    sudo "$mkconfig" -o /boot/grub/grub.cfg >/dev/null 2>&1 || true
  elif command_exists grub2-mkconfig; then
    mkconfig="grub2-mkconfig"
    sudo "$mkconfig" -o /boot/grub2/grub.cfg >/dev/null 2>&1 || true
  fi

  log INFO "Updated GRUB cmdline (removed splash, added plymouth.enable=0)"
  return 0
}

# Updates Limine kernel cmdline to add plymouth.enable=0 disablehooks=plymouth.
#
# Tries /etc/limine-entry-tool.d/ drop-in first, then falls back to
# /etc/default/limine for setups that don't use the entry-tool hook.
#
# Globals:
#   LAST_ERROR - Set on failure
# Returns:
#   0 on success, 1 on failure
_update_limine_cmdline() {
  LAST_ERROR=""

  if [[ -d "$LIMINE_DROPIN_DIR" ]]; then
    if ! update_limine_cmdline "50-disable-plymouth" --append "plymouth.enable=0 disablehooks=plymouth" 2>/dev/null; then
      LAST_ERROR="Failed to update Limine cmdline: $LAST_ERROR"
      return 1
    fi
    log INFO "Added plymouth.enable=0 disablehooks=plymouth to Limine cmdline"
    return 0
  fi

  if [[ -f "$LIMINE_DEFAULT_CONF" ]]; then
    local line='KERNEL_CMDLINE[default]+="plymouth.enable=0 disablehooks=plymouth"'

    if grep -qE 'KERNEL_CMDLINE\[default\]\+=' "$LIMINE_DEFAULT_CONF" 2>/dev/null; then
      if grep -q 'disablehooks=plymouth' "$LIMINE_DEFAULT_CONF" 2>/dev/null; then
        log SKIP "Limine cmdline already configured"
        return 0
      fi
      if ! sudo sed -i 's/KERNEL_CMDLINE\[default\]+="\(.*\)"/KERNEL_CMDLINE[default]+="\1 plymouth.enable=0 disablehooks=plymouth"/' "$LIMINE_DEFAULT_CONF" 2>/dev/null; then
        LAST_ERROR="Failed to update $LIMINE_DEFAULT_CONF"
        return 1
      fi
    else
      if ! printf '%s\n' "$line" | sudo tee -a "$LIMINE_DEFAULT_CONF" >/dev/null 2>&1; then
        LAST_ERROR="Failed to write to $LIMINE_DEFAULT_CONF"
        return 1
      fi
    fi

    log INFO "Added plymouth.enable=0 disablehooks=plymouth to $LIMINE_DEFAULT_CONF"
    return 0
  fi

  log SKIP "No Limine config found ($LIMINE_DROPIN_DIR or $LIMINE_DEFAULT_CONF)"
  return 0
}

# Updates systemd-boot kernel cmdline file.
#
# Globals:
#   LAST_ERROR - Set on failure
# Returns:
#   0 on success, 1 on failure
_update_systemd_boot_cmdline() {
  LAST_ERROR=""

  if [[ ! -f "$SYSTEMD_CMDLINE_FILE" ]]; then
    return 0
  fi

  local current
  current=$(cat "$SYSTEMD_CMDLINE_FILE" 2>/dev/null) || return 0

  local new_cmdline
  if ! new_cmdline=$(_clean_cmdline "$current"); then
    LAST_ERROR="Failed to build new systemd-boot cmdline"
    return 1
  fi

  if [[ "$new_cmdline" == "$current" ]]; then
    log SKIP "systemd-boot cmdline already configured"
    return 0
  fi

  if ! printf '%s' "$new_cmdline" | sudo tee "$SYSTEMD_CMDLINE_FILE" >/dev/null 2>&1; then
    LAST_ERROR="Failed to write $SYSTEMD_CMDLINE_FILE"
    return 1
  fi

  log INFO "Updated systemd-boot cmdline (removed splash, added plymouth.enable=0)"
  return 0
}

# Updates sdboot-manage.conf LINUX_OPTIONS.
#
# Handles the sdboot-manage configuration file used by systemd-boot
# setups that employ the sdboot-manage tool. Regenerates boot entries
# after modification if sdboot-manage is available.
#
# Globals:
#   LAST_ERROR - Set on failure
# Returns:
#   0 on success, 1 on failure
_update_sdboot_manage_conf() {
  LAST_ERROR=""

  if [[ ! -f "$SDMANAGE_CONF" ]]; then
    return 0
  fi

  local current
  current=$(sed -nE 's/^LINUX_OPTIONS="(.*)"/\1/p' "$SDMANAGE_CONF" 2>/dev/null | head -n1)

  if [[ -z "$current" ]]; then
    log SKIP "LINUX_OPTIONS not found in sdboot-manage.conf"
    return 0
  fi

  local new_cmdline
  if ! new_cmdline=$(_clean_cmdline "$current"); then
    LAST_ERROR="Failed to build new sdboot-manage cmdline"
    return 1
  fi

  if [[ "$new_cmdline" == "$current" ]]; then
    log SKIP "sdboot-manage.conf already configured"
    return 0
  fi

  if ! sudo sed -i -E "s|^LINUX_OPTIONS=\"(.*)\"|LINUX_OPTIONS=\"$new_cmdline\"|" "$SDMANAGE_CONF" 2>/dev/null; then
    LAST_ERROR="Failed to update $SDMANAGE_CONF"
    return 1
  fi

  if command_exists sdboot-manage; then
    sudo sdboot-manage gen >/dev/null 2>&1 || true
  fi

  log INFO "Updated sdboot-manage.conf (removed splash, added plymouth.enable=0)"
  return 0
}

# Detects and updates kernel cmdline across all supported bootloaders.
#
# Handles GRUB, Limine, and systemd-boot. Each method is tried
# independently so all configured bootloaders get updated.
#
# Globals:
#   LAST_ERROR - Set on failure
# Returns:
#   0 always (individual failures are logged as warnings)
_update_all_bootloader_cmdlines() {
  LAST_ERROR=""

  _update_grub_cmdline || log WARN "GRUB cmdline update: $LAST_ERROR"
  LAST_ERROR=""
  _update_limine_cmdline || log WARN "Limine cmdline update: $LAST_ERROR"
  LAST_ERROR=""
  _update_systemd_boot_cmdline || log WARN "systemd-boot cmdline update: $LAST_ERROR"
  LAST_ERROR=""
  _update_sdboot_manage_conf || log WARN "sdboot-manage.conf update: $LAST_ERROR"

  return 0
}

main() {
  if ! keep_sudo_alive; then
    die "Failed to keep sudo alive"
  fi

  if ! _plymouth_installed; then
    log SKIP "Plymouth package is not installed"
    exit 0
  fi

  print_box "Disable Plymouth"
  log STEP "Disabling Plymouth"

  _disable_plymouth_services

  if ! _remove_plymouth_from_mkinitcpio; then
    die "Failed to remove Plymouth from mkinitcpio: $LAST_ERROR"
  fi

  log STEP "Updating bootloader kernel cmdline"
  _update_all_bootloader_cmdlines

  log INFO "Regenerating initramfs..."
  if ! regenerate_initramfs; then
    die "Failed to regenerate initramfs: $LAST_ERROR"
  fi

  log INFO "Plymouth disabled successfully"
}

main "$@"
