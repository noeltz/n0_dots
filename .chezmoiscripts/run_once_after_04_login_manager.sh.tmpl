#!/usr/bin/env bash
# 04_login_manager.sh - Configure greetd display manager
# Exit codes: 0 (success), 1 (failure)

{{ template "run_onchange_hash" . }}

set -euo pipefail
shopt -s nullglob globstar

readonly LIB_DIR="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/.chezmoiscripts/lib"

# shellcheck source=/dev/null
source "$LIB_DIR/.lib-common.sh"

readonly GREETD_CONFIG_FILE="/etc/greetd/config.toml"

if ! keep_sudo_alive; then
  die "Failed to keep sudo alive"
fi

disable_conflicting_dms() {
  local -r other_dms=(sddm gdm gdm3 lightdm lxdm emptty)

  local svc status
  for svc in "${other_dms[@]}"; do
    status=$(sudo systemctl is-enabled "${svc}.service" 2>/dev/null || true)

    if [[ "$status" == "enabled" ]]; then
      if sudo systemctl disable "${svc}.service" >/dev/null 2>&1; then
        log INFO "Disabled ${svc}.service"
        reload_systemd_daemon
        return 0
      fi
      log WARN "Failed to disable ${svc}.service"
    fi
  done

  log SKIP "No conflicting display managers found"
}

configure_greetd() {
  write_system_config "$GREETD_CONFIG_FILE" <<EOF || die "Failed to write greetd config file: $LAST_ERROR"
[terminal]
vt = 1

[default_session]
command = "tuigreet --time --remember --remember-session --cmd niri-session"
user = "greeter"
EOF

sudo mkdir -p /var/cache/tuigreet
sudo chown -R greeter:greeter /var/cache/tuigreet

  log INFO "Configured greetd display manager"
}

main() {

  print_box "Login Manager"
  log STEP "greetd Configuration"

  disable_conflicting_dms
  configure_greetd

  if ! enable_service "greetd" "system"; then
    die "Failed : $LAST_ERROR"
  else
    log INFO "${COLOR_GREEN}greetd.service${COLOR_RESET} enabled"
  fi

  log INFO "greetd display manager configuration complete"
}

main "$@"
