#!/usr/bin/env bash
# run_onchange_after_04_login_manager.sh - Configure display manager (cross-distro)
#
# On Arch: enables greetd with tuigreet.
# On Void: enables lidm (lightweight TUI display manager).
# Disables conflicting display managers on both systems.
# Exit codes: 0 (success), 1 (failure)

{{ template "run_onchange_hash" . -}}

{{- $distro := .chezmoi.osRelease.id -}}
{{- if not (or (eq $distro "arch") (eq $distro "void")) -}}
  {{- $idLike := "" -}}
  {{- if hasKey .chezmoi.osRelease "id_like" -}}
    {{- $idLike = .chezmoi.osRelease.id_like -}}
  {{- end -}}
  {{- if contains $idLike "void" -}}
    {{- $distro = "void" -}}
  {{- else if contains $idLike "arch" -}}
    {{- $distro = "arch" -}}
  {{- else if lookPath "xbps-install" -}}
    {{- $distro = "void" -}}
  {{- else if lookPath "pacman" -}}
    {{- $distro = "arch" -}}
  {{- end -}}
{{- end -}}

set -euo pipefail
shopt -s nullglob globstar

readonly LIB_DIR="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/.chezmoiscripts/lib"

# shellcheck source=/dev/null
source "$LIB_DIR/.lib-common.sh"

if ! keep_sudo_alive; then
  die "Failed to keep sudo alive"
fi

# Checks if a runit service is enabled (symlink exists in /var/service).
_is_runit_service_enabled() {
  [[ -L "/var/service/${1}" ]]
}

# Checks if a systemd service is enabled.
_is_systemd_service_enabled() {
  systemctl is-enabled "${1}" >/dev/null 2>&1
}

disable_conflicting_dms() {
  local -r other_dms=(sddm gdm gdm3 lightdm lxdm emptty greetd)
  local svc found=0

  if command -v sv &>/dev/null; then
    for svc in "${other_dms[@]}"; do
      if _is_runit_service_enabled "$svc"; then
        log INFO "Disabling conflicting display manager: ${COLOR_CYAN}${svc}${COLOR_RESET}"
        if sudo rm -f "/var/service/${svc}"; then
          log INFO "Disabled ${svc}"
          found=1
        else
          log WARN "Failed to disable ${svc}: $LAST_ERROR"
        fi
      fi
    done
  elif command -v systemctl &>/dev/null; then
    for svc in "${other_dms[@]}"; do
      if _is_systemd_service_enabled "$svc"; then
        log INFO "Disabling conflicting display manager: ${COLOR_CYAN}${svc}${COLOR_RESET}"
        if disable_service "$svc" "system"; then
          log INFO "Disabled ${svc}"
          found=1
        else
          log WARN "Failed to disable ${svc}: $LAST_ERROR"
        fi
      fi
    done
  fi

  if [[ "$found" -eq 0 ]]; then
    log SKIP "No conflicting display managers found"
  fi
}

{{- if eq $distro "void" }}

configure_lidm() {
  local -r config_file="/etc/lidm.ini"

  if [[ -f "$config_file" ]]; then
    log SKIP "$config_file already exists"
    return 0
  fi

  write_system_config "$config_file" <<EOF || die "Failed to write lidm config: $LAST_ERROR"
# /etc/lidm.ini
[greeter]
cmd = niri
EOF

  log INFO "Configured lidm display manager"
}

disable_conflicting_tty() {
  log STEP "Disabling agetty-tty1 (lidm uses vt=1)"
  if [[ -L "/var/service/agetty-tty1" ]]; then
    if sudo rm -f "/var/service/agetty-tty1"; then
      log INFO "Disabled agetty-tty1"
    else
      log WARN "Failed to disable agetty-tty1: $LAST_ERROR"
    fi
  else
    log SKIP "agetty-tty1 not active"
  fi
}

enable_lidm() {
  local -r link="/var/service/lidm"
  if [[ -L "$link" ]]; then
    log SKIP "lidm already enabled"
    return 0
  fi

  # Create down file so runsv does NOT start the service immediately.
  sudo touch /etc/sv/lidm/down

  if ! sudo ln -s /etc/sv/lidm "$link"; then
    LAST_ERROR="Failed to create lidm symlink"
    die "Failed: $LAST_ERROR"
  fi

  # The down file stays in place during the script run.
  # rc.local removes it on the next boot before runsvdir starts,
  # so lidm starts normally on reboot.
  local -r rc_local="/etc/rc.local"
  local -r rm_cmd="[ -f /etc/sv/lidm/down ] && rm -f /etc/sv/lidm/down"
  if [[ -f "$rc_local" ]]; then
    if ! grep -qF "lidm/down" "$rc_local" 2>/dev/null; then
      printf '%s\n' "$rm_cmd" | sudo tee -a "$rc_local" >/dev/null
    fi
  else
    printf '#!/bin/sh\n%s\n' "$rm_cmd" | sudo tee "$rc_local" >/dev/null
    sudo chmod 755 "$rc_local"
  fi

  log INFO "${COLOR_GREEN}lidm${COLOR_RESET} enabled (will start on next boot)"
}

enable_elogind() {
  local -r sv_dir="/etc/sv/elogind"
  local -r link="/var/service/elogind"
  if [[ -L "$link" ]]; then
    log SKIP "elogind already enabled"
  elif [[ ! -d "$sv_dir" ]]; then
    log WARN "elogind service directory not found at $sv_dir (package may not be installed)"
  elif sudo ln -s "$sv_dir" "$link"; then
    log INFO "${COLOR_GREEN}elogind${COLOR_RESET} enabled (will start on next boot)"
  else
    log WARN "Failed to enable elogind: $LAST_ERROR"
  fi
}

configure_lidm_pam() {
  local -r pam_file="/etc/pam.d/lidm"
  if [[ ! -f "$pam_file" ]]; then
    log INFO "Creating lidm PAM config"
    write_system_config "$pam_file" <<'EOF' || { log WARN "Failed to create $pam_file"; return 1; }
auth       sufficient  pam_rootok.so
auth       required    pam_unix.so
account    required    pam_unix.so
password   required    pam_unix.so
session    required    pam_unix.so
session    optional    pam_elogind.so
EOF
    log INFO "Created lidm PAM config with elogind support"
  elif ! grep -q 'pam_elogind' "$pam_file" 2>/dev/null; then
    log STEP "Adding pam_elogind.so to lidm PAM config"
    if ! grep -q '^session' "$pam_file" 2>/dev/null; then
      echo 'session    optional    pam_elogind.so' | sudo tee -a "$pam_file" >/dev/null
      log INFO "Added pam_elogind.so to $pam_file"
    else
      sudo sed -i '/^session.*pam_unix\.so/a session    optional    pam_elogind.so' "$pam_file" 2>/dev/null
      log INFO "Added pam_elogind.so to $pam_file"
    fi
  else
    log SKIP "lidm PAM config already has elogind"
  fi
}

{{- else }}

readonly GREETD_CONFIG_FILE="/etc/greetd/config.toml"
readonly GREETER_USER="greeter"

configure_greetd() {
  write_system_config "$GREETD_CONFIG_FILE" <<EOF || die "Failed to write greetd config file: $LAST_ERROR"
[terminal]
vt = 1

[default_session]
command = "tuigreet --time --remember --remember-session --cmd niri-session"
user = "${GREETER_USER}"
EOF

  sudo mkdir -p /var/cache/tuigreet
  sudo chown -R "${GREETER_USER}:${GREETER_USER}" /var/cache/tuigreet

  log INFO "Configured greetd display manager (greeter: ${GREETER_USER})"
}

enable_greetd() {
  local -r link="/var/service/greetd"
  if [[ -L "$link" ]]; then
    log SKIP "greetd already enabled"
  elif sudo ln -s /etc/sv/greetd "$link"; then
    log INFO "${COLOR_GREEN}greetd${COLOR_RESET} enabled (will start on next boot)"
  else
    LAST_ERROR="Failed to create greetd symlink"
    die "Failed: $LAST_ERROR"
  fi
}

{{- end }}

main() {
  print_box "Login Manager"

  disable_conflicting_dms

  {{- if eq $distro "void" }}
  configure_lidm
  configure_lidm_pam
  disable_conflicting_tty
  enable_lidm
  enable_elogind
  {{- else }}
  configure_greetd
  enable_greetd
  {{- end }}

  log INFO "Display manager configuration complete"
}

main "$@"
