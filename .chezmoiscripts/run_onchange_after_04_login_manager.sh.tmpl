#!/usr/bin/env bash
# run_onchange_after_04_login_manager.sh - Configure display manager (cross-distro)
#
# Enables greetd with tuigreet on both Arch and Void.
# On Void: vt=7 with _greeter user, keep all agettys.
# On Arch: vt=1 with greeter user, disable agetty-tty1.
# Disables conflicting display managers on both systems.
# Exit codes: 0 (success), 1 (failure)

{{ template "run_onchange_hash" . -}}

{{- $distro := .chezmoi.osRelease.id -}}
{{- if not (or (eq $distro "arch") (eq $distro "void")) -}}
  {{- $idLike := "" -}}
  {{- if hasKey .chezmoi.osRelease "id_like" -}}
    {{- $idLike = .chezmoi.osRelease.id_like -}}
  {{- end -}}
  {{- if contains $idLike "void" -}}
    {{- $distro = "void" -}}
  {{- else if contains $idLike "arch" -}}
    {{- $distro = "arch" -}}
  {{- else if lookPath "xbps-install" -}}
    {{- $distro = "void" -}}
  {{- else if lookPath "pacman" -}}
    {{- $distro = "arch" -}}
  {{- end -}}
{{- end -}}

set -euo pipefail
shopt -s nullglob globstar

readonly LIB_DIR="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/.chezmoiscripts/lib"

# shellcheck source=/dev/null
source "$LIB_DIR/.lib-common.sh"

if ! keep_sudo_alive; then
  die "Failed to keep sudo alive"
fi

# Checks if a runit service is enabled (symlink exists in /var/service).
_is_runit_service_enabled() {
  [[ -L "/var/service/${1}" ]]
}

# Checks if a systemd service is enabled.
_is_systemd_service_enabled() {
  systemctl is-enabled "${1}" >/dev/null 2>&1
}

disable_conflicting_dms() {
  local -r other_dms=(sddm gdm gdm3 lightdm lxdm emptty greetd lidm)
  local svc found=0

  if command -v sv &>/dev/null; then
    for svc in "${other_dms[@]}"; do
      if _is_runit_service_enabled "$svc"; then
        log INFO "Disabling conflicting display manager: ${COLOR_CYAN}${svc}${COLOR_RESET}"
        if sudo rm -f "/var/service/${svc}"; then
          log INFO "Disabled ${svc}"
          found=1
        else
          log WARN "Failed to disable ${svc}: $LAST_ERROR"
        fi
      fi
    done
  elif command -v systemctl &>/dev/null; then
    for svc in "${other_dms[@]}"; do
      if _is_systemd_service_enabled "$svc"; then
        log INFO "Disabling conflicting display manager: ${COLOR_CYAN}${svc}${COLOR_RESET}"
        if disable_service "$svc" "system"; then
          log INFO "Disabled ${svc}"
          found=1
        else
          log WARN "Failed to disable ${svc}: $LAST_ERROR"
        fi
      fi
    done
  fi

  if [[ "$found" -eq 0 ]]; then
    log SKIP "No conflicting display managers found"
  fi
}

readonly GREETD_CONFIG_FILE="/etc/greetd/config.toml"

enable_elogind() {
  local -r sv_dir="/etc/sv/elogind"
  local -r link="/var/service/elogind"
  if [[ -L "$link" ]]; then
    log SKIP "elogind already enabled"
  elif [[ ! -d "$sv_dir" ]]; then
    log WARN "elogind service directory not found at $sv_dir (package may not be installed)"
  elif sudo ln -s "$sv_dir" "$link"; then
    log INFO "${COLOR_GREEN}elogind${COLOR_RESET} enabled (will start on next boot)"
  else
    log WARN "Failed to enable elogind: $LAST_ERROR"
  fi
}

enable_greetd() {
  local -r link="/var/service/greetd"
  if [[ -L "$link" ]]; then
    log SKIP "greetd already enabled"
  elif sudo ln -s /etc/sv/greetd "$link"; then
    log INFO "${COLOR_GREEN}greetd${COLOR_RESET} enabled (will start on next boot)"
  else
    LAST_ERROR="Failed to create greetd symlink"
    die "Failed: $LAST_ERROR"
  fi
}

{{- if eq $distro "void" }}

configure_greetd() {
  write_system_config "$GREETD_CONFIG_FILE" <<EOF || die "Failed to write greetd config file: $LAST_ERROR"
[terminal]
vt = 7

[default_session]
command = "tuigreet --cmd niri"
user = "_greeter"
EOF

  if ! id _greeter &>/dev/null; then
    sudo useradd -r -M -s /sbin/nologin _greeter
    log INFO "Created _greeter user"
  fi

  if ! groups _greeter 2>/dev/null | grep -q video; then
    sudo usermod -aG video _greeter
    log INFO "Added _greeter to video group"
  fi

  log INFO "Configured greetd display manager (greeter: _greeter, vt=7)"
}

{{- else }}

readonly ARCH_GREETER_USER="greeter"

configure_greetd() {
  write_system_config "$GREETD_CONFIG_FILE" <<EOF || die "Failed to write greetd config file: $LAST_ERROR"
[terminal]
vt = 1

[default_session]
command = "tuigreet --time --remember --remember-session --cmd niri-session"
user = "${ARCH_GREETER_USER}"
EOF

  sudo mkdir -p /var/cache/tuigreet
  sudo chown -R "${ARCH_GREETER_USER}:${ARCH_GREETER_USER}" /var/cache/tuigreet

  log INFO "Configured greetd display manager (greeter: ${ARCH_GREETER_USER})"
}

{{- end }}

main() {
  print_box "Login Manager"

  disable_conflicting_dms

  configure_greetd
  enable_greetd

  {{- if eq $distro "void" }}
  enable_elogind
  {{- end }}

  log INFO "Display manager configuration complete"
}

main "$@"
