#!/usr/bin/env bash
# run_once_after_30-vscode-theme.sh - Install VSCode matugen theme extension
#
# Installs the matugen-vscode extension for dynamic theming from local .vsix.
# Exit codes: 0 (success), 1 (failure)

set -euo pipefail
shopt -s nullglob globstar

readonly LIB_DIR="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/.chezmoiscripts/lib"

# shellcheck source=/dev/null
source "$LIB_DIR/.lib-common.sh"

readonly PKG_DIR="{{- .chezmoi.sourceDir -}}/assets/install"

main() {
  print_box "VSCode Theme"

  if ! command_exists codium; then
    if ! command_exists code-oss; then
      log SKIP "codium/code-oss not found — skipping VSCode theme install"
      return 0
    fi
    log STEP "Installing VSCode matugen theme (code-oss)"
    code-oss --install-extension "$PKG_DIR/matugen-vscode-1.1.0.vsix" && log INFO "Theme installed"
    return 0
  fi

  log STEP "Installing VSCode matugen theme"
  codium --install-extension "$PKG_DIR/matugen-vscode-1.1.0.vsix" && log INFO "Theme installed"
}

main "$@"
