#!/usr/bin/env bash
# run_once_after_20-gtk-settings.sh - Configure GTK settings via gsettings
#
# Applies GTK interface settings from chezmoi data (.chezmoidata/gtk.toml).
# Idempotent — gsettings set only writes if value differs.
# Exit codes: 0 (success), 1 (failure)

{{ template "run_onchange_hash" . -}}

set -euo pipefail
shopt -s nullglob globstar

readonly LIB_DIR="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/.chezmoiscripts/lib"

# shellcheck source=/dev/null
source "$LIB_DIR/.lib-common.sh"

main() {
  print_box "GTK Settings"
  log STEP "Applying GTK interface settings"

  {{ range $key, $val := .gtk -}}
  gsettings set org.gnome.desktop.interface {{ $key | kebabcase }} {{ $val | quote }} && log INFO "{{ $key }} set to {{ $val }}"
  {{ end -}}
  
  {{ range $key, $val := .nautilus -}}
  gsettings set org.gnome.nautilus.preferences {{ $key | kebabcase }} {{ $val | quote }} && log INFO "{{ $key }} set to {{ $val }}"
  {{ end -}}
}

main "$@"
