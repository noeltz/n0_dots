#!/usr/bin/env bash
# run_once_after_10-systemd-service.sh - Configure systemd user services
#
# Adds specified systemd user services to niri.service as dependencies.
# Exit codes: 0 (success), 1 (failure)

{{ template "run_onchange_hash" . -}}

set -euo pipefail
shopt -s nullglob globstar

readonly LIB_DIR="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/.chezmoiscripts/lib"

# shellcheck source=/dev/null
source "$LIB_DIR/.lib-common.sh"

main() {
  print_box "Systemd Services"
  log STEP "Adding user services to niri.service"

  systemctl --user daemon-reload
  {{ range .services -}}
  systemctl --user add-wants niri.service {{ . | quote }} && log INFO "Added {{ . }} service"
  {{ end -}}
  systemctl --user daemon-reload
}

main "$@"
