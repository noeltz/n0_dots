#!/usr/bin/env bash
# run_onchange_before_13-system-fixes.sh - Misc system service fixes (Void/runit)
#
# - avahi-daemon chroot: avahi chroots into /var/empty by default, which lacks
#   /dev/null ("chroot.c: open() failed") and cannot follow the host
#   /etc/resolv.conf when it is a symlink ("Failed to open /etc/resolv.conf:
#   Invalid argument"). Setting "chroot-directory=/" is rejected by this avahi
#   build ("Invalid configuration key"), which makes the daemon fail to start
#   entirely, so we never touch that key. Instead we populate the default jail
#   (/var/empty) with the device/files avahi expects. The chroot is preserved
#   (avahi still drops to the unprivileged avahi user) and the errors are
#   silenced.
# - dangling /var/service symlinks: a leftover link whose target under
#   /etc/sv no longer exists (e.g. sv-netmount) errors at every boot.
# - NetworkManager resolvconf: handled by _fix_networkmanager_resolvconf().
#
# Idempotent. Runs whenever the script changes so previously mis-configured
# services are repaired.
# Exit codes: 0 (success), 1 (failure)

{{ template "run_onchange_hash" . -}}

set -euo pipefail
shopt -s nullglob globstar

readonly LIB_DIR="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/.chezmoiscripts/lib"

# shellcheck source=/dev/null
source "$LIB_DIR/.lib-common.sh"

# Fixes avahi-daemon's chroot jail instead of disabling the chroot.
#
# avahi chroots into /var/empty by default, which lacks /dev/null (causing
# "chroot.c: open() failed") and cannot follow the host /etc/resolv.conf when it
# is a symlink (causing "Failed to open /etc/resolv.conf: Invalid argument").
# Setting "chroot-directory=/" is rejected by this avahi build ("Invalid
# configuration key"), so we never touch that key. Instead we populate the
# default jail with a /dev/null node and a copy of resolv.conf. The chroot is
# preserved (avahi still drops to the unprivileged avahi user) and the errors
# are silenced. Any previously-added chroot-directory= line is removed so a
# broken config from an earlier run does not prevent avahi from starting.
#
# Globals: none
# Returns: 0 always
_fix_avahi_chroot() {
  local cfg="/etc/avahi/avahi-daemon.conf"
  if [[ ! -f "$cfg" ]]; then
    log SKIP "avahi-daemon.conf not found - skipping avahi chroot fix"
    return 0
  fi

  log STEP "Fixing avahi-daemon chroot jail (/var/empty)"

  # Remove any chroot-directory= line: it is invalid on this build and would
  # make the whole config fail to parse (daemon exits with "Invalid
  # configuration key").
  sudo sed -i '/^chroot-directory=/d' "$cfg"

  # Populate the default chroot jail so avahi finds what it expects.
  sudo mkdir -p /var/empty/dev /var/empty/etc
  if [[ ! -e /var/empty/dev/null ]]; then
    sudo mknod /var/empty/dev/null c 1 3
  fi
  sudo chmod 666 /var/empty/dev/null
  sudo cp -f /etc/resolv.conf /var/empty/etc/resolv.conf 2>/dev/null || true

  if sudo sv status avahi-daemon >/dev/null 2>&1; then
    sudo sv restart avahi-daemon || log WARN "Failed to restart avahi-daemon"
  fi
  return 0
}

# Removes dangling /var/service symlinks (target under /etc/sv no longer
# exists). A leftover like sv-netmount produces a "file does not exist" error at
# every boot and clutters sv status output. Only symlinks whose target is gone
# are removed; valid service links are left untouched.
#
# Globals: none
# Returns: 0 always
_prune_dead_service_symlinks() {
  log STEP "Removing dangling /var/service symlinks"
  local l
  for l in /var/service/*; do
    [[ -L "$l" ]] || continue
    [[ -e "$l" ]] && continue
    sudo rm -f "$l" && log INFO "removed dangling service symlink: $(basename "$l")"
  done
  return 0
}

# Forces NetworkManager's rc-manager to "symlink" so it writes /etc/resolv.conf
# directly instead of shelling out to resolvconf.
#
# On this setup /etc/resolv.conf is already a symlink to
# /run/NetworkManager/resolv.conf, so NM manages DNS itself. But with the
# resolvconf binary present, NM's default rc-manager auto-detects "resolvconf"
# and fails to commit DNS ("resolvconf failed with status 256") even though DNS
# otherwise works. Pinning "symlink" stops NM from invoking resolvconf.
#
# Globals: none
# Returns: 0 always
_fix_networkmanager_resolvconf() {
  local dropin_dir="/etc/NetworkManager/conf.d"
  local dropin="${dropin_dir}/zz-resolvconf.conf"

  sudo mkdir -p "$dropin_dir"
  if sudo grep -q '^rc-manager=' "$dropin" 2>/dev/null; then
    log INFO "NetworkManager rc-manager already pinned; skipping"
    return 0
  fi

  log STEP "Pinning NetworkManager rc-manager=symlink (avoid resolvconf failures)"
  printf '[main]\nrc-manager=symlink\n' | sudo tee "$dropin" >/dev/null

  if sudo sv status NetworkManager >/dev/null 2>&1; then
    sudo sv restart NetworkManager || log WARN "Failed to restart NetworkManager"
  fi
  return 0
}

main() {
  if ! request_sudo; then
    die "Failed to obtain sudo access"
  fi

  local init
  init=$(get_init_system 2>/dev/null || true)
  if [[ "$init" != "runit" ]]; then
    log SKIP "Not a runit system (detected: ${init:-unknown}) - skipping system fixes"
    return 0
  fi

  print_box "System Fixes"

  _fix_avahi_chroot
  _fix_networkmanager_resolvconf
  _prune_dead_service_symlinks
}

main "$@"
