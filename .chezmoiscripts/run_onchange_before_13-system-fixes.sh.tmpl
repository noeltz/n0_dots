#!/usr/bin/env bash
# run_onchange_before_13-system-fixes.sh - Misc system service fixes (Void/runit)
#
# - avahi-daemon chroot: avahi chroots into /var/empty, which lacks /dev/null,
#   causing "chroot.c: open() failed". We provide the /dev/null char device
#   inside the chroot. Separately, avahi cannot see the host /etc/resolv.conf
#   from inside the chroot ("Failed to open /etc/resolv.conf: Invalid argument");
#   an avahi-resolv runit service bind-mounts the host resolv.conf into the
#   chroot and restarts avahi so it can read upstream DNS servers.
# - NetworkManager resolvconf: handled by _fix_networkmanager_resolvconf().
#
# Idempotent. Runs whenever the script changes so previously mis-configured
# services are repaired.
# Exit codes: 0 (success), 1 (failure)

{{ template "run_onchange_hash" . -}}

set -euo pipefail
shopt -s nullglob globstar

readonly LIB_DIR="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/.chezmoiscripts/lib"

# shellcheck source=/dev/null
source "$LIB_DIR/.lib-common.sh"

# Fixes avahi-daemon's "chroot.c: open() failed" error.
#
# avahi chroots into /var/empty, but that directory has no /dev/null, so the
# post-chroot open() fails and avahi logs an error on every start (it still
# runs). Provide a /dev/null char device inside the chroot so the default
# chroot works and the error disappears, preserving the chroot hardening.
# Also drop any empty "chroot-directory=" line (an empty value makes
# chroot("") fail and prevents avahi from starting at all).
#
# Globals: none
# Returns: 0 always
_fix_avahi_chroot() {
  local cfg="/etc/avahi/avahi-daemon.conf"
  if [[ ! -f "$cfg" ]]; then
    log SKIP "avahi-daemon.conf not found - skipping avahi chroot fix"
    return 0
  fi

  log STEP "Providing /var/empty/dev/null for avahi-daemon chroot"

  # Remove a previously-added empty chroot-directory= line if present.
  sudo sed -i '/^chroot-directory=$/d' "$cfg"

  # Create the chroot's /dev/null char device (1,3).
  sudo mkdir -p /var/empty/dev
  if [[ ! -c /var/empty/dev/null ]]; then
    sudo mknod /var/empty/dev/null c 1 3
    sudo chmod 666 /var/empty/dev/null
  fi

  if sudo sv status avahi-daemon >/dev/null 2>&1; then
    sudo sv restart avahi-daemon || log WARN "Failed to restart avahi-daemon"
  fi
  return 0
}

# Installs a runit service (avahi-resolv) that bind-mounts the host
# /etc/resolv.conf into avahi-daemon's chroot (/var/empty) so avahi can read
# upstream DNS servers. Without it, avahi logs "Failed to open /etc/resolv.conf:
# Invalid argument" because it is chrooted and cannot see the host file. The
# service also restarts avahi-daemon once the mount is in place.
#
# Globals: none
# Returns: 0 always
_fix_avahi_resolvconf() {
  local svc_dir="/etc/sv/avahi-resolv"
  sudo mkdir -p "$svc_dir"

  log STEP "Installing avahi-resolv bind-mount service"
  sudo tee "$svc_dir/run" >/dev/null <<'AVAHID_RUN'
#!/bin/sh
# Bind-mount the host resolv.conf into avahi-daemon's chroot (/var/empty) so
# avahi can read upstream DNS servers. Runs once at boot; the process then
# blocks to keep the runit service up, and restarts avahi-daemon so it picks
# up the mounted file.
set -e

mkdir -p /var/empty/etc

# Wait for NetworkManager/resolvconf to create the real resolv.conf.
i=0
while [ ! -e /etc/resolv.conf ] && [ "$i" -lt 30 ]; do
  sleep 1
  i=$((i + 1))
done

SRC=$(readlink -f /etc/resolv.conf 2>/dev/null || true)
if [ -n "$SRC" ] && [ -e "$SRC" ]; then
  mount --bind "$SRC" /var/empty/etc/resolv.conf 2>/dev/null || true
fi

# avahi reads resolv.conf at startup; restart it now that the file is mounted.
sv restart avahi-daemon 2>/dev/null || true

exec tail -f /dev/null
AVAHID_RUN

  sudo chmod 755 "$svc_dir/run"

  if enable_service avahi-resolv system; then
    log INFO "avahi-resolv service enabled"
  else
    log WARN "Failed to enable avahi-resolv: ${LAST_ERROR:-unknown error}"
  fi
  return 0
}

# Forces NetworkManager's rc-manager to "symlink" so it writes /etc/resolv.conf
# directly instead of shelling out to resolvconf.
#
# On this setup /etc/resolv.conf is already a symlink to
# /run/NetworkManager/resolv.conf, so NM manages DNS itself. But with the
# resolvconf binary present, NM's default rc-manager auto-detects "resolvconf"
# and fails to commit DNS ("resolvconf failed with status 256") even though DNS
# otherwise works. Pinning "symlink" stops NM from invoking resolvconf.
#
# Globals: none
# Returns: 0 always
_fix_networkmanager_resolvconf() {
  local dropin_dir="/etc/NetworkManager/conf.d"
  local dropin="${dropin_dir}/zz-resolvconf.conf"

  sudo mkdir -p "$dropin_dir"
  if sudo grep -q '^rc-manager=' "$dropin" 2>/dev/null; then
    log INFO "NetworkManager rc-manager already pinned; skipping"
    return 0
  fi

  log STEP "Pinning NetworkManager rc-manager=symlink (avoid resolvconf failures)"
  printf '[main]\nrc-manager=symlink\n' | sudo tee "$dropin" >/dev/null

  if sudo sv status NetworkManager >/dev/null 2>&1; then
    sudo sv restart NetworkManager || log WARN "Failed to restart NetworkManager"
  fi
  return 0
}

main() {
  if ! request_sudo; then
    die "Failed to obtain sudo access"
  fi

  local init
  init=$(get_init_system 2>/dev/null || true)
  if [[ "$init" != "runit" ]]; then
    log SKIP "Not a runit system (detected: ${init:-unknown}) - skipping system fixes"
    return 0
  fi

  print_box "System Fixes"

  _fix_avahi_chroot
  _fix_avahi_resolvconf
  _fix_networkmanager_resolvconf
}

main "$@"
