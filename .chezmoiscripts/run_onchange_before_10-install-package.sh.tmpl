#!/usr/bin/env bash
# run_onchange_before_10-install-package.sh - Install packages via AUR helper

# Installs system and AUR packages using the configured AUR helper.
# Reads package lists from .chezmoidata/packages.toml.
# Exit codes: 0 (success), 1 (failure)

{{ template "run_onchange_hash" . -}}

packages=()
aur_packages=()

{{ range .packages.arch.pacman }}
packages+=({{- . | quote -}})
{{ end }}

{{ range .packages.arch.aur }}
aur_packages+=({{- . | quote -}})
{{ end }}

log_step() { printf '%b\n' "$1" >&2; }
die() { log_step "$1"; exit 1; }

command -v paru >/dev/null 2>&1 || die "paru is not installed. Run_once_before_00-install-aur-helper must run first."

log_step "> Installing base packages..."
paru -S --needed "${packages[@]}" || log_step "WARNING: Package installation failed."

log_step "> Installing AUR packages..."
paru -S --needed "${aur_packages[@]}" || log_step "WARNING: AUR package installation failed."