#!/usr/bin/env bash
# run_onchange_before_10-install-package.sh - Install packages (Void Linux + Nix)
#
# Installs:
#   - Void Linux packages via xbps (.chezmoidata/packages_void.toml)
#   - Nix packages via nix-env into the current user's profile
#     (.chezmoidata/packages_nix.toml)
#
# On Void, once xbps installs the 'nix' package, the script bootstraps the
# nix-daemon (runit), subscribes to the nixpkgs-unstable channel, and installs
# the declared Nix packages for the current user.
# Exit codes: 0 (success)

{{ template "run_onchange_hash" . -}}

set -euo pipefail
shopt -s nullglob globstar

readonly LIB_DIR="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/.chezmoiscripts/lib"

# shellcheck source=/dev/null
source "$LIB_DIR/.lib-common.sh"

# --- Template-generated package arrays ---

packages=()
nix_packages=()

{{ range .packages_void.packages -}}
packages+=({{ . | quote }})
{{ end -}}

{{ range .packages_nix.packages -}}
nix_packages+=({{ . | quote }})
{{ end -}}

# --- Void Linux installation path ---

_main_xbps() {
  log STEP "Syncing package repositories"
  sudo xbps-install -S

  # Enable nonfree repo if needed (for spotify, chromium-widevine)
  if ! xbps-query void-repo-nonfree &>/dev/null 2>&1; then
    log STEP "Enabling nonfree repository"
    sudo xbps-install -y void-repo-nonfree || log WARN "Failed to install void-repo-nonfree"
    sudo xbps-install -S
  fi

  # Filter to packages not yet installed
  local -a to_install=()
  local pkg
  for pkg in "${packages[@]}"; do
    if xbps-query "$pkg" >/dev/null 2>&1; then
      log SKIP "${COLOR_GREEN}${pkg}${COLOR_RESET} exists"
    else
      to_install+=("$pkg")
    fi
  done

  if [[ ${#to_install[@]} -eq 0 ]]; then
    log INFO "All Void packages already installed"
    return 0
  fi

  log STEP "Installing Void packages..."
  if ! sudo xbps-install -y "${to_install[@]}"; then
    log WARN "Package installation had failures. Attempting individual installs..."
    for pkg in "${to_install[@]}"; do
      if ! sudo xbps-install -y "$pkg" 2>/dev/null; then
        log WARN "Failed to install: ${COLOR_YELLOW}${pkg}${COLOR_RESET}"
      fi
    done
  fi
}

# --- Nix installation path ---

# Activates nix tools for the current shell.
#
# Void's nix package ships a profile.d snippet that prepends the nix profile
# bin dirs to PATH. We source it (and add the default profile dir as a
# fallback) so nix-env works in the same run that installed nix via xbps.
#
# Globals:
#   PATH - Prepended with nix bin directories when missing
# Returns:
#   0 if nix-env is available, 1 otherwise
_ensure_nix_in_path() {
  local script
  for script in /etc/profile.d/nix.sh /etc/profile.d/nix-daemon.sh; do
    if [[ -r "$script" ]]; then
      # shellcheck source=/dev/null
      source "$script"
      break
    fi
  done

  case ":$PATH:" in
  *":/nix/var/nix/profiles/default/bin:"*) ;;
  *)
    if [[ -d /nix/var/nix/profiles/default/bin ]]; then
      export PATH="/nix/var/nix/profiles/default/bin:$PATH"
    fi
    ;;
  esac

  hash -r 2>/dev/null || true
  command -v nix-env >/dev/null 2>&1
}

# Waits for the nix-daemon socket to appear (first-time start latency).
#
# Returns:
#   0 once the socket exists, 1 on timeout
_await_nix_daemon() {
  local i
  for ((i = 0; i < 15; i++)); do
    [[ -S /nix/var/nix/daemon-socket/socket ]] && return 0
    sleep 1
  done
  log WARN "nix-daemon socket not found after waiting"
  return 1
}

# Checks whether a Nix package is present in the current user's profile.
#
# nix-env -q lists "name-version"; this matches the leading package name.
#
# Arguments:
#   $1 - Package name
# Returns:
#   0 if installed, 1 otherwise
_nix_pkg_installed() {
  local pkg="$1"
  nix-env -q --installed 2>/dev/null | awk '{print $1}' | grep -qE "^${pkg}(-[0-9]|$)"
}

_main_nix() {
  if ! _ensure_nix_in_path; then
    log SKIP "nix not installed - skipping Nix setup"
    return 0
  fi

  log STEP "Enabling nix-daemon service"
  if ! enable_service nix-daemon system; then
    log WARN "Failed to enable nix-daemon: $LAST_ERROR - skipping Nix packages"
    return 0
  fi
  _await_nix_daemon || true

  if [[ ${#nix_packages[@]} -eq 0 ]]; then
    log SKIP "No Nix packages declared"
    return 0
  fi

  log STEP "Configuring Nix channel (nixpkgs-unstable)"
  if ! nix-channel --list 2>/dev/null | grep -q "nixpkgs-unstable"; then
    nix-channel --add https://nixos.org/channels/nixpkgs-unstable
  fi
  nix-channel --update || log WARN "nix-channel --update failed"

  log STEP "Installing Nix packages..."
  local pkg
  for pkg in "${nix_packages[@]}"; do
    if _nix_pkg_installed "$pkg"; then
      log SKIP "${COLOR_GREEN}${pkg}${COLOR_RESET} (nix) exists"
      continue
    fi
    if nix-env -i "$pkg"; then
      log INFO "Installed (nix): ${COLOR_GREEN}${pkg}${COLOR_RESET}"
    else
      log WARN "Failed to install (nix): ${COLOR_YELLOW}${pkg}${COLOR_RESET}"
    fi
  done
}

# --- Main ---

main() {
  if ! request_sudo; then
    die "Failed to obtain sudo access"
  fi

  print_box "Packages"

  if ! command_exists xbps-install; then
    log WARN "xbps-install not found - not a Void Linux system, skipping package installation"
    return 0
  fi

  _main_xbps
  _main_nix
}

main "$@"
