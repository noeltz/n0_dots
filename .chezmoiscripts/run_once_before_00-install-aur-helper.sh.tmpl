#!/usr/bin/env bash
# run_once_before_00-install-aur-helper.sh - System bootstrap (cross-distro)
#
# Arch Linux: installs paru (AUR helper) and configures Chaotic-AUR repository.
# Void Linux: runs system update and enables nonfree repository.
# Skipped if already configured. Runs unattended.
# Exit codes: 0 (success), 1 (failure)

{{- $distro := .chezmoi.osRelease.id -}}
{{- if not (or (eq $distro "arch") (eq $distro "void")) -}}
  {{- $idLike := .chezmoi.osRelease.id_like | default "" -}}
  {{- if contains $idLike "void" -}}
    {{- $distro = "void" -}}
  {{- else if contains $idLike "arch" -}}
    {{- $distro = "arch" -}}
  {{- end -}}
{{- end -}}

set -euo pipefail
shopt -s nullglob globstar

readonly LIB_DIR="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/.chezmoiscripts/lib"

# shellcheck source=/dev/null
source "$LIB_DIR/.lib-common.sh"

{{- if eq $distro "arch" }}

readonly AUR_HELPER="paru"

main() {
  if ! request_sudo; then
    die "Failed to obtain sudo access"
  fi

  print_box "AUR Helper & Chaotic AUR"

  # --- Update Arch Linux Keyrings ---
  log STEP "Updating Arch Linux keyrings"
  sudo pacman -Sy --noconfirm archlinux-keyring

  # --- Chaotic AUR ---
  if ! grep -q '^\[chaotic-aur\]' /etc/pacman.conf; then
    log STEP "Setting up Chaotic AUR"
    sudo pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com
    sudo pacman-key --lsign-key 3056513887B78AEB
    sudo pacman -U --noconfirm --needed \
      'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst' \
      'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst'
    printf '\n[chaotic-aur]\nInclude = /etc/pacman.d/chaotic-mirrorlist\n' \
      | sudo tee -a /etc/pacman.conf >/dev/null
    sudo pacman -Sy --noconfirm
    log INFO "Chaotic AUR added."
  else
    log SKIP "Chaotic AUR already configured"
  fi

  # --- AUR Helper ---
  if command -v "$AUR_HELPER" &>/dev/null; then
    log SKIP "$AUR_HELPER is already installed"
    exit 0
  fi

  log STEP "Installing $AUR_HELPER"
  sudo pacman -S --needed base-devel

  # Try installing from Chaotic-AUR first (faster), fall back to git+make
  if sudo pacman -S --noconfirm "$AUR_HELPER" 2>/dev/null; then
    log INFO "$AUR_HELPER installed from Chaotic-AUR"
  else
    log INFO "Building $AUR_HELPER from AUR source..."
    git clone "https://aur.archlinux.org/${AUR_HELPER}-bin.git" /tmp/aur-helper
    (cd /tmp/aur-helper && makepkg -si --noconfirm)
    log INFO "$AUR_HELPER installed from AUR source"
  fi

  log STEP "Running full system update"
  "$AUR_HELPER" -Syu --noconfirm --sudoloop
  log INFO "System update complete."
}

{{- else if eq $distro "void" }}

main() {
  if ! request_sudo; then
    die "Failed to obtain sudo access"
  fi

  print_box "Void Linux Bootstrap"

  # --- Full system update ---
  log STEP "Running full system update"
  sudo xbps-install -Su
  log INFO "System update complete."

  # --- Enable nonfree repository (needed for spotify, chromium-widevine) ---
  if ! xbps-query void-repo-nonfree &>/dev/null 2>&1; then
    log STEP "Enabling nonfree repository"
    sudo xbps-install -y void-repo-nonfree
    sudo xbps-install -S
    log INFO "Nonfree repository enabled."
  else
    log SKIP "Nonfree repository already enabled"
  fi

  log INFO "Void Linux bootstrap complete."
}

{{- else }}

main() {
  die "Unsupported distribution. This script supports Arch and Void Linux only."
}

{{- end }}

main "$@"
