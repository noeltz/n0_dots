#!/usr/bin/env bash
# run_once_before_99-switch-shell.sh - Switch default shell to configured option

# Switches the default shell to the configured shell (zsh) via chsh.
# Exit codes: 0 (success), 1 (failure)

set -euo pipefail

readonly LIB_DIR="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/.chezmoiscripts/lib"

# shellcheck source=/dev/null
source "$LIB_DIR/.lib-common.sh"

if confirm "Switch shell to {{ .chezmoi.config.data.shell -}}?"; then
  log STEP "Switching shell to {{ .chezmoi.config.data.shell -}}"
  chsh -s "$(which {{ .chezmoi.config.data.shell -}})"
fi
