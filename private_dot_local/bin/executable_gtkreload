#!/usr/bin/env bash

# Start user D-Bus session if not already running
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    eval "$(dbus-launch --sh-syntax)"
fi

# Get desired Mode and current Icons
MODE=$(noctalia msg theme-mode-get)
ICONS=$(gsettings get org.gnome.desktop.interface icon-theme)

if [[ "$MODE" == "light" ]]; then
    SHOCK_THEME="HighContrastInverse"
    SHOCK_SCHEME="prefer-dark"
else
    SHOCK_THEME="HighContrast"
    SHOCK_SCHEME="prefer-light"
fi

# Shock (Force Cache Dump)
echo "Switch gtk-theme, color-scheme and icon-theme settings to clear cache..."
gsettings set org.gnome.desktop.interface gtk-theme "$SHOCK_THEME"
sleep 0.1
gsettings set org.gnome.desktop.interface color-scheme "$SHOCK_SCHEME"


# CRITICAL: Wait for the system to process the shock.
sleep 0.3

# Restore (Reload with New Colors)
/usr/share/noctalia/assets/templates/gtk/apply.sh $MODE
sleep 0.3
gsettings set org.gnome.desktop.interface icon-theme "hicolor"
sleep 0.2
gsettings set org.gnome.desktop.interface icon-theme "$ICONS"

echo "Done."
