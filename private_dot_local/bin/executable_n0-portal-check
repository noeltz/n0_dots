#!/usr/bin/env python3
"""Check installed portal registrations, activation commands and share picker."""
import configparser
from pathlib import Path
import shlex
import shutil
import sys
import os

errors = []
for desktop in ('umbriel', 'niri'):
    override = Path.home() / '.config/xdg-desktop-portal' / f'{desktop}-portals.conf'
    if 'XDG_CONFIG_HOME' in __import__('os').environ:
        override = Path(__import__('os').environ['XDG_CONFIG_HOME']) / 'xdg-desktop-portal' / override.name
    config = configparser.ConfigParser(); config.optionxform = str
    if not config.read(override):
        errors.append(f'Missing {override}'); continue
    for interface, backends in config['preferred'].items():
        for backend in filter(None, backends.split(';')):
            registration = Path('/usr/share/xdg-desktop-portal/portals') / f'{backend}.portal'
            portal = configparser.ConfigParser(); portal.optionxform = str
            if not portal.read(registration):
                errors.append(f'Missing backend registration: {registration}'); continue
            info = portal['portal']
            if interface != 'default' and interface not in info.get('Interfaces', '').split(';'):
                errors.append(f'{backend} does not declare {interface}')
            bus = info.get('DBusName', '')
            activation = Path('/usr/share/dbus-1/services') / f'{bus}.service'
            service = configparser.ConfigParser(); service.optionxform = str
            if not service.read(activation):
                errors.append(f'Missing activation: {activation}'); continue
            command = shlex.split(service['D-BUS Service'].get('Exec', ''))
            if not command or not shutil.which(command[0]):
                errors.append(f'Invalid activation executable: {activation}')
picker_paths = [Path('/usr/libexec/umbriel-share-picker'), Path('/usr/lib/umbriel-share-picker')]
found = shutil.which('umbriel-share-picker')
if found: picker_paths.append(Path(found))
if not any(path.is_file() and os.access(path, os.X_OK) for path in picker_paths):
    errors.append('Missing executable umbriel-share-picker in PATH or /usr/libexec or /usr/lib')
for error in errors: print(error, file=sys.stderr)
if errors: sys.exit(1)
print('Portal registrations and executable paths passed; file dialogs and screen sharing still need a fresh-login test.')
