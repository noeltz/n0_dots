# Session entry point. dinit auto-starts the service named 'boot'; it is an
# internal (grouping) service that brings up the niri user-session daemons in
# dependency order. The dbus-env one-shot is waited-for (best-effort) so it runs
# early without failing the whole session.
type = internal
depends-on: pipewire
depends-on: wireplumber
depends-on: pipewire-pulse
depends-on: noctalia
waits-for: dbus-env
